{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "/",
        "/about-us",
        "/minutes",
        "/meetings",
        "/news",
        "/faq",
        "/submit",
        "/visual-history",
        "/news/welcome-the-fan-advisory-board",
        "/faq/what-is-the-fan-advisory-board",
        "/meetings/2024-01-29"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
