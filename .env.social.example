# Copy to .env.social (gitignored). Used by scripts/social-post.mjs.
# Facebook: a Meta app linked to the FAB page; a long-lived Page access token with pages_manage_posts.
FB_PAGE_ID=
FB_PAGE_TOKEN=
# X: developer app on the FAB account with Read and Write permissions (OAuth 1.0a user context).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
