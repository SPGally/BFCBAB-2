# Public build-time settings. Copy to .env for local dev; on Netlify set these as environment variables.
# reCAPTCHA v2 (checkbox) site key. Also set SITE_RECAPTCHA_KEY and SITE_RECAPTCHA_SECRET in Netlify so
# the form endpoint verifies tokens. Leave unset and the Submit form works without a captcha.
VITE_RECAPTCHA_SITE_KEY=
